# OPTIONAL TEMPLATE for running the API and worker locally.
# This file is not read directly. Copy it to .env if you want these values to
# be loaded by Docker Compose or pydantic-settings during local development.
# It is not needed by the deployed AWS stack or by StartConsole.ps1.
# Keep real AWS credentials, Cognito secrets, and access tokens out of this file.

AWS_REGION=eu-north-1
AWS_ENDPOINT_URL=
TABLE_NAME=shipment-event-platform-dev
EVENT_BUS_NAME=shipment-event-platform-dev
PROCESSING_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/000000000000/shipment-event-platform-dev-processing
LOG_LEVEL=INFO
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SHIPMENT_RETENTION_DAYS=30

# Never put Cognito client secrets or access tokens in a committed file.
