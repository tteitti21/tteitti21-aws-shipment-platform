# OPTIONAL TEMPLATE for manually configuring the local browser console.
# This file is not read directly. Copy it to .env.console, replace the
# placeholders, and pass it with: docker compose --env-file .env.console ...
# It is not needed when using scripts/powershell/StartConsole.ps1 because that
# launcher reads the values from AWS into temporary process environment variables.
# It is not used by the deployed AWS stack. .env.console is gitignored.
# Never commit the client secret or an access token.
# SNS controls also require temporary AWS SDK credentials. Prefer StartConsole.ps1,
# which exports them from the active AWS CLI session without writing them here.

CONSOLE_API_URL=https://replace.execute-api.eu-north-1.amazonaws.com
CONSOLE_TOKEN_URL=https://replace.auth.eu-north-1.amazoncognito.com/oauth2/token
CONSOLE_CLIENT_ID=replace-with-cognito-app-client-id
CONSOLE_CLIENT_SECRET=replace-with-cognito-app-client-secret
CONSOLE_SCOPES=shipment-api/shipments.write shipment-api/shipments.read
CONSOLE_SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:000000000000:shipment-event-platform-dev-results
CONSOLE_REQUEST_TIMEOUT_SECONDS=15
AWS_REGION=eu-north-1
LOG_LEVEL=INFO
